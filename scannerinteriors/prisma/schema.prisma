generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  LUXURY
  MINIMALIST
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  CLOSED
}

model Project {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String          @db.Text
  category    ProjectCategory
  coverImage  String
  images      ProjectImage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([createdAt])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String
  sortOrder Int     @default(0)

  @@unique([projectId, sortOrder])
  @@index([projectId])
}

model Service {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  imageUrl    String
  enquiries   Enquiry[]
}

/// `service` is the related Service. The foreign key column is `serviceId`.
model Enquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String?
  serviceId       String?
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  projectLocation String?
  budget          String?
  message         String        @db.Text
  status          EnquiryStatus @default(NEW)
  submissionKey   String        @unique
  createdAt       DateTime      @default(now())

  @@index([status, createdAt])
  @@index([email])
  @@index([serviceId])
}
