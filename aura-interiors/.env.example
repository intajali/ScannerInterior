# Server-only. Never prefix this with NEXT_PUBLIC_.
# Replace USER, PASSWORD, host, port, and database name with your PostgreSQL instance.
# The database must already exist before running migrations.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aura_interiors"

# Public site URL used for metadata. This value is safe to expose to the browser.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Country code and number, digits only. The contact page shows WhatsApp when this is set.
# NEXT_PUBLIC_WHATSAPP_NUMBER="971500000000"
